{
  "openapi": "3.0.0",
  "info": { "title": "HARU API", "version": "1.0.0" },
  "servers": [{ "url": "http://localhost:4000" }],
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["auth"],
        "summary": "회원가입",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["login_id", "password", "nickname"],
                "properties": {
                  "login_id": { "type": "string", "example": "test1" },
                  "password": { "type": "string", "example": "1234" },
                  "nickname": { "type": "string", "example": "tester" },
                  "job_role_id": { "type": "integer", "nullable": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "가입 성공" },
          "400": { "description": "입력값 오류" },
          "409": { "description": "아이디 또는 닉네임 중복" }
        }
      }
    }
  }
}
