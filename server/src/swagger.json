{
  "openapi": "3.0.0",
  "info": {
    "title": "HARU API",
    "version": "1.0.0",
    "description": "HARU 서버 API. 인증이 필요한 API는 우측 상단 Authorize에 로그인 응답의 accessToken을 넣고 호출하세요."
  },
  "servers": [{ "url": "http://localhost:4000" }],
  "tags": [
    { "name": "health", "description": "서버 상태" },
    { "name": "auth", "description": "회원가입 / 로그인" },
    { "name": "job-roles", "description": "직무 목록" },
    { "name": "home", "description": "홈 화면" },
    { "name": "profile", "description": "내 프로필 / 계정 관리" },
    { "name": "record", "description": "기록 탭 (통계 / 기록 목록)" },
    { "name": "question", "description": "질문 생성" },
    { "name": "answer", "description": "답변 제출 / 채점 / 기록 상세" }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["health"],
        "summary": "서버 + DB 연결 상태 확인",
        "responses": {
          "200": {
            "description": "서버와 DB 모두 정상",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "name": { "type": "string", "example": "HARU" },
                    "db": { "type": "string", "example": "connected" }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["auth"],
        "summary": "회원가입",
        "description": "- login_id: 영문 소문자 + 숫자 4~20자\n- password: 8~64자, 영문과 숫자 각각 1개 이상\n- nickname: 공백 제외 2~10자 (앞뒤 공백은 잘라서 저장)\n- job_role_id: 선택. 정수여야 하며 job_roles에 있는 id",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["login_id", "password", "nickname"],
                "properties": {
                  "login_id": { "type": "string", "pattern": "^[a-z0-9]{4,20}$", "example": "test1" },
                  "password": { "type": "string", "minLength": 8, "maxLength": 64, "example": "haru1234" },
                  "nickname": { "type": "string", "example": "tester" },
                  "job_role_id": { "type": "integer", "nullable": true, "example": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "가입 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "integer", "example": 1 },
                    "nickname": { "type": "string", "example": "tester" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "입력값 오류 또는 존재하지 않는 직무",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "아이디는 영문 소문자와 숫자 4~20자로 입력해 주세요." }
              }
            }
          },
          "409": {
            "description": "아이디 또는 닉네임 중복",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "이미 사용 중인 아이디 or 닉네임입니다." }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "로그인",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["login_id", "password"],
                "properties": {
                  "login_id": { "type": "string", "example": "test1" },
                  "password": { "type": "string", "example": "haru1234" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공. accessToken은 14일 유효한 JWT (payload: userId, login_id)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIs..." },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "integer", "example": 1 },
                        "login_id": { "type": "string", "example": "test1" },
                        "nickname": { "type": "string", "example": "tester" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "아이디 또는 비밀번호 누락",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "아이디, 비밀번호를 입력해 주세요." }
              }
            }
          },
          "401": {
            "description": "아이디가 없거나 비밀번호가 틀림 (같은 문구)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "아이디 또는 비밀번호가 맞지 않아요." }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/auth/google": {
      "post": {
        "tags": ["auth"],
        "summary": "구글 로그인 (웹)",
        "description": "웹 구글 버튼(Google Identity Services)이 준 ID 토큰을 검증하고 로그인. 처음이면 자동 가입 (닉네임 하루 + 숫자 4자리). jobRoleId 가 null 이면 앱에서 직무 선택 화면으로",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["idToken"],
                "properties": {
                  "idToken": { "type": "string", "example": "eyJhbGciOiJSUzI1NiIs..." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIs..." },
                    "isNewUser": { "type": "boolean", "example": true },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "integer", "example": 7 },
                        "nickname": { "type": "string", "example": "하루4821" },
                        "jobRoleId": { "type": "integer", "nullable": true, "example": null }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "idToken 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "구글 로그인 정보가 없어요." } } }
          },
          "401": {
            "description": "구글 토큰 검증 실패 (만료, 다른 앱용 토큰 등)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "구글 로그인에 실패했어요." } } }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/job-roles": {
      "get": {
        "tags": ["job-roles"],
        "summary": "직무 목록",
        "description": "sort_order 오름차순. 로그인 없이 호출 가능 (회원가입 화면에서 사용)",
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobRoles": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/JobRole" }
                    }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/home": {
      "get": {
        "tags": ["home"],
        "summary": "홈 화면 정보",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "nickname": { "type": "string", "example": "tester" },
                    "jobRoleId": { "type": "integer", "nullable": true, "example": 1 },
                    "jobRoleName": { "type": "string", "nullable": true, "example": "프론트엔드 개발자" },
                    "last7Days": {
                      "type": "array",
                      "description": "오늘 포함 최근 7일, 오래된 순",
                      "items": {
                        "type": "object",
                        "properties": {
                          "date": { "type": "string", "format": "date", "example": "2026-11-23" },
                          "day": { "type": "string", "description": "요일 글자", "example": "월" },
                          "status": { "type": "string", "enum": ["done", "missed", "today"], "description": "done=답변함, missed=안 함, today=오늘인데 아직 안 함" }
                        }
                      }
                    },
                    "streak": { "type": "integer", "description": "연속 답변 일수. 오늘 아직 안 했으면 어제까지로 계산", "example": 3 },
                    "scores": {
                      "type": "array",
                      "description": "정식 답변 + 피드백 완료 점수 최근 6개, 오래된 순",
                      "items": {
                        "type": "object",
                        "properties": {
                          "date": { "type": "string", "format": "date", "example": "2026-11-15" },
                          "score": { "type": "integer", "example": 68 }
                        }
                      }
                    },
                    "quests": {
                      "type": "object",
                      "properties": {
                        "answeredToday": { "type": "boolean", "description": "오늘 정식 답변을 했는지", "example": true },
                        "over80Today": { "type": "boolean", "description": "오늘 답변(정식 + 재답변) 중 80점 이상이 있는지", "example": false },
                        "weeklyCount": { "type": "integer", "description": "이번 주 월요일부터 오늘까지 정식 답변 수", "example": 3 }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/profile": {
      "get": {
        "tags": ["profile"],
        "summary": "내 프로필 조회",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "nickname": { "type": "string", "example": "tester" },
                    "jobRoleId": { "type": "integer", "nullable": true, "example": 1 },
                    "jobRoleName": { "type": "string", "nullable": true, "example": "프론트엔드 개발자" },
                    "email": { "type": "string", "nullable": true, "example": null },
                    "loginId": { "type": "string", "nullable": true, "description": "아이디 가입이면 아이디, 구글 가입이면 null", "example": "tester" },
                    "answerCount": { "type": "integer", "description": "정식 답변 수 (탈퇴 확인 문구용)", "example": 24 }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/profile/updatePassword": {
      "patch": {
        "tags": ["profile"],
        "summary": "비밀번호 변경",
        "description": "newPassword는 8~64자, 영문과 숫자 각각 1개 이상. 구글 가입 계정(비밀번호 없음)은 항상 400",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["currentPassword", "newPassword"],
                "properties": {
                  "currentPassword": { "type": "string", "example": "haru1234" },
                  "newPassword": { "type": "string", "example": "haru5678" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "변경 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" },
                "example": { "message": "비밀번호를 변경했어요." }
              }
            }
          },
          "400": {
            "description": "입력값 오류 또는 현재 비밀번호가 맞지 않음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "현재 비밀번호가 맞지 않아요." }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/profile/updateNickname": {
      "patch": {
        "tags": ["profile"],
        "summary": "닉네임 변경",
        "description": "공백 제외 2~10자. 앞뒤 공백은 잘라서 저장",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["newNickname"],
                "properties": {
                  "newNickname": { "type": "string", "example": "하루" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "변경 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" },
                "example": { "message": "닉네임을 변경했어요." }
              }
            }
          },
          "400": {
            "description": "닉네임이 없거나 공백 제외 2~10자가 아님",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "닉네임은 공백 제외 2~10자로 입력해 주세요." }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": {
            "description": "이미 사용 중인 닉네임",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "이미 사용 중인 닉네임입니다." }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/profile/updateJob": {
      "patch": {
        "tags": ["profile"],
        "summary": "직무 변경",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["newJobRoleId"],
                "properties": {
                  "newJobRoleId": { "type": "integer", "description": "job_roles.id", "example": 2 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "변경 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" },
                "example": { "message": "직무가 변경되었습니다." }
              }
            }
          },
          "400": {
            "description": "newJobRoleId 누락",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "변경할 직무를 선택해 주세요." }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "사용자를 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "사용자를 찾을 수 없어요." }
              }
            }
          },
          "500": {
            "description": "DB 오류 (존재하지 않는 직무 id도 현재는 여기로 떨어짐)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "직무를 바꾸지 못했어요." }
              }
            }
          }
        }
      }
    },
    "/api/profile/deleteUser": {
      "delete": {
        "tags": ["profile"],
        "summary": "회원 탈퇴",
        "description": "회원 행을 삭제. 답변/피드백/본인 전용 AI 질문은 FK CASCADE로 함께 삭제됨",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "탈퇴 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" },
                "example": { "message": "회원 탈퇴가 완료됐어요." }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": {
            "description": "DB 오류",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "잠시 후 다시 시도해 주세요." }
              }
            }
          }
        }
      }
    },
    "/api/stats/summary": {
      "get": {
        "tags": ["record"],
        "summary": "기록 요약 (평균 / 총 답변 / 최고 점수)",
        "description": "정식 답변 + 피드백 완료 기준. 기록이 없으면 averageScore, bestScore 는 null, totalAnswers 는 0",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "averageScore": { "type": "integer", "nullable": true, "example": 79 },
                    "totalAnswers": { "type": "integer", "example": 24 },
                    "bestScore": { "type": "integer", "nullable": true, "example": 92 }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/stats/scores": {
      "get": {
        "tags": ["record"],
        "summary": "기록 탭 점수 흐름",
        "description": "정식 답변 + 피드백 완료만, 최신 limit 개를 오래된 순으로",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "category", "in": "query", "required": false, "description": "질문 유형. 생략하면 전체", "schema": { "type": "string", "enum": ["intro", "motivation", "personality", "technical"] } },
          { "name": "limit", "in": "query", "required": false, "description": "기본 8, 최대 30", "schema": { "type": "integer", "default": 8 } }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "points": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "answerId": { "type": "integer", "example": 31 },
                          "answerDate": { "type": "string", "format": "date", "example": "2026-11-15" },
                          "score": { "type": "integer", "example": 62 }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "잘못된 쿼리 값",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "질문 유형이 올바르지 않아요." }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/answers": {
      "get": {
        "tags": ["record"],
        "summary": "기록 목록",
        "description": "정식 답변만 최신 날짜순. 재답변은 retryCount 로 개수만. nextCursor 가 null 이면 마지막 페이지",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "category", "in": "query", "required": false, "description": "질문 유형. 생략하면 전체", "schema": { "type": "string", "enum": ["intro", "motivation", "personality", "technical"] } },
          { "name": "cursor", "in": "query", "required": false, "description": "이전 응답의 nextCursor (그 답변보다 이전 날짜부터)", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "required": false, "description": "기본 20, 최대 50", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "integer", "example": 42 },
                          "questionId": { "type": "integer", "example": 12 },
                          "answerDate": { "type": "string", "format": "date", "example": "2026-11-23" },
                          "category": { "type": "string", "enum": ["intro", "motivation", "personality", "technical"], "example": "motivation" },
                          "question": { "type": "string", "example": "우리 회사에 지원한 이유는 무엇인가요?" },
                          "score": { "type": "integer", "nullable": true, "description": "피드백 완료가 아니면 null", "example": 88 },
                          "feedbackStatus": { "type": "string", "enum": ["pending", "done", "failed"], "example": "done" },
                          "retryCount": { "type": "integer", "example": 1 }
                        }
                      }
                    },
                    "nextCursor": { "type": "integer", "nullable": true, "example": 38 }
                  }
                }
              }
            }
          },
          "400": {
            "description": "잘못된 쿼리 값",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "질문 유형이 올바르지 않아요." }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "post": {
        "tags": ["answer"],
        "summary": "답변 제출 + 채점",
        "description": "답변을 저장하고 바로 AI 채점. 채점이 실패해도 답변은 남고 feedbackStatus 가 failed, feedback 이 null. 정식 답변은 하루 1번, 재답변은 원본 하나당 하루 5번",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["questionId", "content"],
                "properties": {
                  "questionId": { "type": "integer", "example": 12 },
                  "content": { "type": "string", "description": "1~1000자", "example": "저는 사람들이 매일 쓰는 서비스를 만들고 싶어서 지원했습니다." },
                  "retryOfAnswerId": { "type": "integer", "nullable": true, "description": "재답변이면 원본(정식) 답변 id", "example": 42 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "저장 성공 (채점 성공 또는 실패)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GradeResult" } } }
          },
          "400": {
            "description": "답변 길이 또는 번호가 올바르지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "답변은 1~1000자로 적어 주세요." } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "질문이 없거나 다른 회원 전용 질문",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "질문을 찾을 수 없어요." } } }
          },
          "409": {
            "description": "오늘 정식 답변을 이미 함",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "오늘 정식 답변은 이미 했어요." } } }
          },
          "422": {
            "description": "재답변 원본이 없음 (내 정식 답변이 아니거나 질문이 다름)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "다시 답할 원본 답변을 찾을 수 없어요." } } }
          },
          "429": {
            "description": "오늘 이 답변의 재답변을 5번 다 함",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "재답변은 하루에 5번까지 할 수 있어요." } } }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/answers/{id}": {
      "get": {
        "tags": ["answer"],
        "summary": "기록 상세",
        "description": "답변 + 질문 + 첨삭 + 점수 변화 + 재답변 목록. 점수 변화는 재답변이면 원본, 정식 답변이면 바로 이전 정식 답변과 비교. 재답변 id 로 조회하면 retries 는 빈 배열",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 42 }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnswerDetail" } } }
          },
          "400": {
            "description": "id 가 올바르지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "답변 번호가 올바르지 않아요." } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": {
            "description": "다른 회원의 답변",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "내 기록만 볼 수 있어요." } } }
          },
          "404": {
            "description": "답변이 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "기록을 찾을 수 없어요." } } }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/answers/{id}/feedback": {
      "post": {
        "tags": ["answer"],
        "summary": "다시 채점",
        "description": "채점에 실패한(feedbackStatus = failed) 내 답변을 같은 내용으로 다시 채점",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 42 }
        ],
        "responses": {
          "200": {
            "description": "채점 시도 완료 (다시 실패하면 feedback 이 null)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GradeResult" } } }
          },
          "400": {
            "description": "id 가 올바르지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "답변 번호가 올바르지 않아요." } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": {
            "description": "다른 회원의 답변",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "내 답변만 채점할 수 있어요." } } }
          },
          "404": {
            "description": "답변이 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "답변을 찾을 수 없어요." } } }
          },
          "409": {
            "description": "채점 실패 상태가 아님 (이미 채점됨 또는 채점 중)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "다시 채점할 답변이 아니에요." } } }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/questions/postQuestion": {
      "post": {
        "tags": ["question"],
        "summary": "질문 생성",
        "description": "회원 직무에 맞춰 AI 가 새 질문을 만들고 저장 (그 회원 전용 질문). category 를 생략하면 네 가지 중 랜덤",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "category": { "type": "string", "enum": ["intro", "motivation", "personality", "technical"], "example": "technical" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "integer", "example": 30 },
                    "category": { "type": "string", "enum": ["intro", "motivation", "personality", "technical"], "example": "technical" },
                    "content": { "type": "string", "example": "React에서 상태 관리가 필요한 경우 어떤 방법을 선택하시고, 그 이유와 장단점을 설명해 주세요." }
                  }
                }
              }
            }
          },
          "400": {
            "description": "질문 유형이 올바르지 않거나 직무를 아직 고르지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "직무를 먼저 골라 주세요." } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "회원이 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "회원 정보를 찾을 수 없어요." } } }
          },
          "500": {
            "description": "AI 질문 생성 실패 또는 서버 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "질문을 만들지 못했어요." } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      },
      "Message": {
        "type": "object",
        "properties": { "message": { "type": "string" } }
      },
      "JobRole": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "프론트엔드 개발자" }
        }
      },
      "Feedback": {
        "type": "object",
        "properties": {
          "score": { "type": "integer", "minimum": 0, "maximum": 100, "example": 82 },
          "strength": { "type": "string", "example": "회사 서비스를 구체적으로 언급했어요." },
          "weakness": { "type": "string", "example": "지원 이유가 내 경험과 잘 이어지지 않아요." },
          "suggestion": { "type": "string", "example": "직접 만든 프로젝트를 예로 들어 보세요." }
        }
      },
      "GradeResult": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "object",
            "properties": {
              "id": { "type": "integer", "example": 42 },
              "feedbackStatus": { "type": "string", "enum": ["done", "failed"], "example": "done" }
            }
          },
          "feedback": { "allOf": [{ "$ref": "#/components/schemas/Feedback" }], "nullable": true, "description": "채점 실패면 null" }
        }
      },
      "AnswerDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 42 },
          "questionId": { "type": "integer", "example": 12 },
          "category": { "type": "string", "enum": ["intro", "motivation", "personality", "technical"], "example": "motivation" },
          "question": { "type": "string", "example": "우리 회사에 지원한 이유는 무엇인가요?" },
          "content": { "type": "string", "example": "저는 사람들이 매일 쓰는 서비스를 만들고 싶어서 지원했습니다." },
          "answerDate": { "type": "string", "format": "date", "example": "2026-11-23" },
          "createdAt": { "type": "string", "format": "date-time", "example": "2026-11-23T06:40:00.000Z" },
          "retryOfAnswerId": { "type": "integer", "nullable": true, "description": "재답변이면 원본 답변 id", "example": null },
          "feedbackStatus": { "type": "string", "enum": ["pending", "done", "failed"], "example": "done" },
          "feedback": { "allOf": [{ "$ref": "#/components/schemas/Feedback" }], "nullable": true, "description": "채점 완료가 아니면 null" },
          "delta": { "type": "integer", "nullable": true, "description": "비교 대상과의 점수 차이. 비교 대상이 없으면 null", "example": 8 },
          "previous": {
            "type": "object",
            "nullable": true,
            "description": "비교 대상 (재답변이면 원본, 정식 답변이면 이전 정식 답변)",
            "properties": {
              "date": { "type": "string", "format": "date", "example": "2026-11-22" },
              "score": { "type": "integer", "example": 74 }
            }
          },
          "retries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "integer", "example": 43 },
                "createdAt": { "type": "string", "format": "date-time", "example": "2026-11-23T06:40:00.000Z" },
                "feedbackStatus": { "type": "string", "enum": ["pending", "done", "failed"], "example": "done" },
                "score": { "type": "integer", "nullable": true, "example": 88 },
                "delta": { "type": "integer", "nullable": true, "description": "원본 대비 점수 차이", "example": 6 }
              }
            }
          },
          "retriesLeftToday": { "type": "integer", "description": "오늘 원본 답변에 더 할 수 있는 재답변 수", "example": 4 }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "토큰이 없거나 유효하지 않음 (또는 탈퇴한 회원)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "로그인이 필요해요." }
          }
        }
      },
      "InternalError": {
        "description": "서버 내부 오류",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "Internal Server Error" }
          }
        }
      }
    }
  }
}
